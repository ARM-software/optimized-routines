// Polynomial and range-reduction constants for binary16 e^x.
//
// Copyright (c) 2026, Arm Limited.
// SPDX-License-Identifier: MIT OR Apache-2.0 WITH LLVM-exception

deg = 5;
a = -log(2)/2;
b = log(2)/2;
f = exp(x);

// Return p minimizing
//   |f(x) - poly(x) - x^d*p(x)| / |f(x)|.
approx = proc(poly, d) {
  return remez(1 - poly(x)/f(x), deg-d, [a;b], x^d/f(x), 1e-10);
};

// Fix the leading coefficients, then fit all remaining coefficients in one
// weighted Remez step and round them to binary32.
poly = 1 + x + x^2*approx(1 + x, 2);

// These are the values stored in float32x4_t coefficient vectors.
stored_poly = 0;
for i from 0 to deg do {
  stored_poly = stored_poly + round(coeff(poly, i), SG, RN) * x^i;
};

ln2 = round(log(2), SG, RN);
inv_ln2 = round(1/log(2), SG, RN);
special_bound = 18;

display = hexadecimal;
print("interval: [", a, b, "]");
print("unrounded minimax coefficients:");
for i from 0 to deg do coeff(poly, i);
print("stored binary32 coefficients:");
for i from 0 to deg do round(coeff(poly, i), SG, RN);
print("stored-poly relative error:",
      accurateinfnorm(1-stored_poly(x)/f(x), [a;b], 30));
print("stored-poly absolute error:",
      accurateinfnorm(f(x)-stored_poly(x), [a;b], 30));
print("inv_ln2:", inv_ln2);
print("ln2:", ln2);
print("special_bound:", special_bound);
quit;
